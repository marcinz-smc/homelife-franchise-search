# Copy live values from 1Password (see hlfs-1pass/README.md). Never commit this file.

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/brokerages-map

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Auth — change these before first login
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@homelife.local
ADMIN_PASSWORD=change-me-now
COOKIE_SECURE=false

# Mapbox — VITE_MAPBOX_TOKEN must be a public pk. token for the browser map
MAPBOX_TOKEN=pk.your_mapbox_token_here
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Machine ingest for franchise-scan JSON
# POST http://127.0.0.1:4000/api/ingest/leads
# Header: X-Ingest-Key: <this value>
# Body: the scored JSON object (or an array of them)
INGEST_API_KEY=replace-with-a-long-random-string
